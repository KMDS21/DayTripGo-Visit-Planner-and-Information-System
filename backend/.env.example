# DayTripGO Server Environment Variables
# Copy this file to .env and fill in your actual values

# Server
PORT=5000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
# Legacy fallback (used only if SUPABASE_SECRET_KEY is unset):
# SUPABASE_SERVICE_KEY=your-legacy-service-role-key

# JWT Authentication
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# Admin login (optional override — when BOTH are set, they win over the
# admins table; leave unset to authenticate against the database)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
